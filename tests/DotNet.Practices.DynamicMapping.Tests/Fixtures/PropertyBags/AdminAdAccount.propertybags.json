[
  {
    "id": "AdminAdAccountData",
    "properties": [
      {
        "id": "Domain",
        "name": {
          "": "Domain",
          "de": "Domäne",
          "it": "Dominio",
          "fr": "Domaine"
        },
        "type": "lookup",
        "lookup": "Lookup.AdAccountDomain",
        "validators": {
          "required": true
        },
        "errorMessages": {
          "required": {
            "": "Cannot be empty",
            "de": "Kann nicht leer sein",
            "it": "Non può essere vuoto",
            "fr": "Ne peux pas être vide"
          }
        }
      },
      {
        "id": "SamAccountName",
        "unique": "ADAccountData",
        "name": {
          "": "User ID",
          "de": "Benutzer-ID",
          "it": "ID utente",
          "fr": "ID d'utilisateur"
        },
        "type": "text",
        "defaultValue": "$Services.GetFiveTwoOneIdValue(Context.Owner.Lastname, Context.Owner.Firstname, false, '-adm-26')",
        "validators": {
          "required": true,
          "pattern": "^[^\\[\\],:;\\|=@\\+\\*\\?<>/\\\\]+$",
          "maxlength": 20
        },
        "errorMessages": {
          "maxlength": {
            "": "Can contain up to 20 characters",
            "de": "Kann bis zu 20 Zeichen enthalten",
            "it": "Può contenere fino a 20 caratteri",
            "fr": "Peut contenir jusqu'à 20 caractères"
          }
        }
      },
      {
        "id": "DisplayName",
        "name": {
          "": "Catalog name",
          "de": "Katalogname",
          "it": "Nome del catalogo",
          "fr": "Nom du catalogue"
        },
        "type": "text",
        "valueGenerator": "$Context.SamAccountName",
        "readonly": true
      },
      {
        "id": "AdGuid",
        "name": "AD Guid",
        "type": "uniqueIdentifier"
      },
      {
        "id": "DistinguishedName",
        "name": {
          "":"Distinguished name",
          "de":"Distinguierter Name",
          "fr":"Nom distingué",
          "it":"Nome distinto"
        },
        "type": "text",
		"valueGenerator": "$ $'CN={Context.SamAccountName},{Services.GetProvisioningContainer(Context.Options.ProvisioningMapping.Values, 'AdminAdAccountContainer')}'",
        "readOnly": true
      },
      {
        "id": "IdForTargetSystem",
        "name": {
          "": "User ID",
          "de": "Benutzer-ID",
          "it": "ID utente",
          "fr": "ID d'utilisateur"
        },
        "type": "text",
        "valueGenerator": "$Services.GetIdToCheck(Context.Domain.Key,Context.SamAccountName)",
